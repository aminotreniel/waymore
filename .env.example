NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Enable only for a demo deployment; anyone with access can enter a test account.
NEXT_PUBLIC_DEMO_LOGIN=false
WAYMORE_DEMO_LOGIN=false
# Server-only JSON array of the three test accounts; never use NEXT_PUBLIC for this.
WAYMORE_DEMO_ACCOUNTS=[]

# Auction lab (/dealer/lab). Admin only, and off unless this is true.
WAYMORE_LAB=false
# Server-only Supabase secret/service key. The lab uses it ONLY to create and
# delete its own test fixtures and dealer accounts. Never prefix with NEXT_PUBLIC.
# Get it with: npx supabase projects api-keys --project-ref <ref> --reveal -o json
SUPABASE_SECRET_KEY=
